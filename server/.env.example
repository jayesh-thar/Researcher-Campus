# Researcher Campus Express API Server Environment Configuration

# Server HTTP Port (Default: 5000)
PORT=5000

# Node Environment ('development' for local testing, 'production' for live deployment)
NODE_ENV=development

# Client CORS Allowed Origin
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas Cloud)
# Example Local: mongodb://127.0.0.1:27017/researcher_campus
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/researcher_campus
MONGODB_URI=mongodb://127.0.0.1:27017/researcher_campus

# Dual-Token JWT Secret Keys (32+ character strings)
JWT_SECRET=super_secret_jwt_access_key_change_in_production_32chars
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_32chars

# AES-256-GCM Encryption Key for Google Drive Refresh Tokens (Exactly 64 Hexadecimal Characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google Gemini Pro AI API Key (Optional - Fallback heuristics used if omitted)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
